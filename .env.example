# Celesto Sandbox Gauntlet Environment Configuration
# Use placeholders only in this file. Never put real keys or secrets here.

# Execution Provider: cloud or local
CELESTO_PROVIDER=cloud

# Celesto API Key
CELESTO_API_KEY=replace-me

# Celesto Backend
CELESTO_BACKEND=firecracker

# Configurable LLM Provider
LLM_BASE_URL=https://example-llm-host/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-with-a-model-name

# PostgreSQL Ledger Database URL
DATABASE_URL=postgresql://ledger:ledger@ledger:5432/ledger

# Application Port
API_PORT=8080
